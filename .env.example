# Supabase project credentials (Dashboard → Project Settings → API)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only. Never expose this to the client or commit it.
# Used by scripts/migrate-seed.ts and server-side admin operations.
SUPABASE_SECRET_KEY=your-service-role-key
